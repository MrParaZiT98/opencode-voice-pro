{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/gui.tsx", "src/voice/**/*.ts", "src/voice/**/*.js"]
}
